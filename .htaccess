# ---------------------------------------------------------------------
# Matikan "streaming" keluaran PHP.
#
# Di XAMPP, output_buffering = 0, sehingga halaman dikirim ke browser
# sepotong-sepotong sambil PHP masih bekerja. Akibatnya bagian hero
# tampil lebih dulu, lalu kartu game menyusul satu per satu — dan
# indikator memuat keburu hilang sebelum semua kartu selesai muncul.
#
# Dengan buffer besar di bawah ini, seluruh halaman dirakit di server
# dahulu lalu dikirim sekaligus. Indikator memuat (dari halaman asal)
# tetap tampak sampai halaman tujuan benar-benar lengkap.
# ---------------------------------------------------------------------
<IfModule php_module>
    php_value output_buffering 4194304
</IfModule>
